# Breadcrumb environment reference.
# Copy the backend section to backend/.env and the frontend section to frontend/.env.local.
# Everything is optional for local demo mode: `npm install && npm run dev` works with no .env at all.

# ============================== backend/.env ==============================

# --- Core ---
NODE_ENV=development
PORT=4000
# Browser origins allowed to call the API (comma-separated). First one is used for OAuth redirects back to the app.
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000

# Signs Breadcrumb session tokens. REQUIRED in production. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_JWT_SECRET=
# Encrypts stored Twitch OAuth tokens (AES-256-GCM). REQUIRED in production when Twitch is configured. Never change it after tokens are stored.
TOKEN_ENCRYPTION_KEY=

# --- Modes ---
# true: enables the demo account, sample data and simulated chat. Set false for a live-only deployment.
DEMO_MODE=true
# Simulated chat stream for the demo account (only while its dashboard is open).
DEMO_CHAT_SIMULATOR=true
# Allow viewers to submit clues outside the Twitch extension iframe via a session link. Defaults to DEMO_MODE.
ALLOW_ANONYMOUS_VIEWERS=

# --- Supabase (omit both to use the in-memory store) ---
SUPABASE_URL=
# Service-role key: server-side only. Never put it in the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI provider ---
# demo (default): always use local heuristics; no API key or AI network request.
# auto: opt into OpenAI when both key and model are set. openai: require OpenAI.
AI_PROVIDER=demo
# --- OpenAI (omit both to use the labelled demo heuristic) ---
OPENAI_API_KEY=
# Any model that supports the Responses API with Structured Outputs (json_schema). Check the current model list.
OPENAI_MODEL=
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_OUTPUT_TOKENS=4000

# --- Twitch (https://dev.twitch.tv/console) ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Must exactly match an OAuth Redirect URL registered on the Twitch application.
TWITCH_REDIRECT_URI=http://localhost:4000/api/auth/twitch/callback
# Twitch Extension (optional): the extension's client ID and base64 shared secret (Extension > Settings > Extension Secrets).
TWITCH_EXTENSION_CLIENT_ID=
TWITCH_EXTENSION_SECRET=

# --- Chat Pulse ---
# Batch interval while a dashboard is open (0 disables automatic batches; manual refresh still works).
CHAT_PULSE_INTERVAL_SECONDS=25
CHAT_PULSE_MIN_MESSAGES=5
CHAT_PULSE_MAX_MESSAGES=150

# --- Chat Guard thresholds ---
GUARD_DUPLICATE_WINDOW_SECONDS=30
GUARD_DUPLICATE_THRESHOLD=3
GUARD_COPYPASTA_MIN_LENGTH=20
GUARD_SIMILARITY_THRESHOLD=0.75
GUARD_FLOOD_WINDOW_SECONDS=10
GUARD_FLOOD_THRESHOLD=6
GUARD_LINK_WINDOW_SECONDS=300
GUARD_LINK_THRESHOLD=3

# =========================== frontend/.env.local ===========================

# Public URL of the backend (REST + Socket.IO).
NEXT_PUBLIC_API_URL=http://localhost:4000
