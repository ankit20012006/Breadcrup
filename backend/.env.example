# Breadcrumb backend environment. Copy to backend/.env (git-ignored) and fill in locally.
# Never commit backend/.env, and never put these values in frontend env files (NEXT_PUBLIC_*).
# Everything is optional for demo mode. The full reference is in ../.env.example.

PORT=4000
FRONTEND_URL=http://localhost:3000
DEMO_MODE=true

# Keeps logins valid across backend restarts (any long random string).
APP_JWT_SECRET=

# --- AI provider ---
# auto   = OpenAI when OPENAI_API_KEY and OPENAI_MODEL are both set, otherwise the labelled demo heuristic
# openai = require OpenAI; the backend refuses to start if the key or model is missing
# demo   = always use the demo heuristic, even if a key is present (offline fallback)
AI_PROVIDER=auto

# Your secret key from https://platform.openai.com/api-keys. Server-side only.
OPENAI_API_KEY=
# A model ID available to your account that supports the Responses API with Structured Outputs (json_schema).
OPENAI_MODEL=
OPENAI_TIMEOUT_MS=30000
# Max tokens per response. Reasoning models count reasoning tokens here.
OPENAI_MAX_OUTPUT_TOKENS=4000
